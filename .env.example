# Copy this file to ".env" and adjust the values for your environment.
# The real ".env" file is git-ignored and must never be committed.

# Set to True only for local development.
DJANGO_DEBUG=True

# Generate a unique value for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated list of hosts allowed to serve the site.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins trusted for CSRF over HTTPS (production domain), e.g.:
#   https://your-name.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database connection. Leave empty to use the local SQLite database.
# PostgreSQL example: postgres://user:password@host:5432/dbname
# MySQL example:      mysql://user:password@host:3306/dbname
DATABASE_URL=
